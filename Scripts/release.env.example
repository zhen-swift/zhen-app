# Scripts/ship.sh's settings. Copy to Releases/release.env (git ignores Releases/).
# Names only, never a password: IDENTITY is a certificate in the login keychain
# (`security find-identity -v -p codesigning`), and NOTARY_PROFILE is the keychain
# profile `xcrun notarytool store-credentials <name> --team-id S8662L649U` made.
IDENTITY="Developer ID Application: <Name> (S8662L649U)"
NOTARY_PROFILE=zhen-notary
