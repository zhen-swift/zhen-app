    "osFingerprintingFastSynPortScans": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OS fingerprinting and fast SYN port scans need raw network sockets, which macOS only grants to root. The engine is a small helper that runs only during scans and only sends results back to this app. Everything else works without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identificación del sistema operativo y los escaneos SYN rápidos de puertos necesitan sockets de red sin procesar, que macOS solo concede a root. El motor es un pequeño asistente que solo se ejecuta durante los escaneos y solo envía resultados a esta app. Todo lo demás funciona sin él."
          }
        }
      }
    },
